model WhatsAppAccount {
  id                 String   @id @default(uuid())
  name               String   // e.g., "Main Sales", "Customer Support"
  phoneNumber        String   // e.g., "+91 9876543210"
  phoneId            String?  // Meta WhatsApp Phone ID
  businessAccountId  String?  // Meta WABA ID
  businessManagerId  String?  // Meta Business Manager ID
  accessToken        String?  // Masked or encrypted token
  webhookVerifyToken String?
  status             String   @default("CONNECTED") // CONNECTED, DISCONNECTED, VERIFICATION_REQUIRED, RESTRICTED
  dailyLimit         String   @default("10K per day")
  usedToday          Int      @default(1250)
  qualityRating      String   @default("GREEN") // GREEN, YELLOW, RED
  isDefault          Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  conversations      WhatsAppConversation[]
}

model WhatsAppConversation {
  id                 String   @id @default(uuid())
  accountId          String
  account            WhatsAppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  customerId         String
  customer           Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  assignedEmployeeId String?
  assignedEmployee   Employee? @relation("AssignedAgent", fields: [assignedEmployeeId], references: [id])

  teamId             String?
  team               Team?    @relation(fields: [teamId], references: [id])

  status             String   @default("OPEN") // OPEN, CLOSED, SNOOZED, PENDING
  leadStatus         String   @default("New Lead") // New Lead, Contacted, Qualified, Negotiation, Won, Lost
  orderStatus        String?  // Processing, Packed, Dispatched, Delivered, Payment Pending
  customerType       String   @default("Wholesale") // Retailer, Wholesaler, Distributor, VIP

  aiHandled          Boolean  @default(true)
  aiConfidence       Float    @default(0.92)
  unreadCount        Int      @default(0)

  lastMessageText    String?
  lastMessageAt      DateTime @default(now())
  tags               String?  // Comma separated tags e.g. "Hot Lead, Follow-up"

  snoozedUntil       DateTime?
  followUpDueAt      DateTime?
  slaStatus          String   @default("GREEN") // GREEN, ORANGE, RED

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

