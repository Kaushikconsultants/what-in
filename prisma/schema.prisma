generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// ---------------------------------------------------------
// Multi-Tenant SaaS Platform: Organizations & Subscriptions
// ---------------------------------------------------------
model Organization {
  id                    String    @id @default(uuid())
  name                  String    // Company Legal Name e.g. "Acme Clothing Pvt Ltd"
  slug                  String    @unique // Unique URL slug e.g. "acme-clothing"
  tradeName             String?
  industry              String?   @default("Apparel & Garments") // Apparel, Manufacturing, Wholesale, Retail
  businessType          String?   @default("Private Limited") // Pvt Ltd, Partnership, Proprietorship
  gstin                 String?
  pan                   String?
  phone                 String?
  email                 String
  website               String?
  logoUrl               String?
  address               String?
  city                  String?
  state                 String?
  pincode               String?
  country               String    @default("India")

  // Subscription Plan & Billing Cycle
  subscriptionPlan      String    @default("GROWTH") // TRIAL, STARTER, GROWTH, ENTERPRISE, CUSTOM
  billingCycle          String    @default("MONTHLY") // MONTHLY, QUARTERLY, ANNUALLY
  subscriptionStatus    String    @default("ACTIVE")  // TRIAL, ACTIVE, PAST_DUE, EXPIRED, CANCELLED
  trialEndsAt           DateTime?
  currentPeriodStart    DateTime  @default(now())
  currentPeriodEnd      DateTime  @default(now())
  cancelAtPeriodEnd     Boolean   @default(false)

  // Payment Gateway References
  gatewayCustomerId     String?   // Razorpay Customer ID
  gatewaySubscriptionId String?   // Razorpay Subscription ID

  // Quotas & Feature Access
  maxUsers              Int       @default(10)
  maxBranches           Int       @default(3)
  maxWarehouses         Int       @default(2)
  monthlyOrderLimit     Int       @default(2000)
  whatsAppCreditBalance Int       @default(1000)

  isGstEnabled          Boolean   @default(true)
  isWhatsAppEnabled     Boolean   @default(true)
  isEWayBillEnabled     Boolean   @default(true)
  isHrmsEnabled         Boolean   @default(true)

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  users                 User[]
  employees             Employee[]
  customers             Customer[]
  vendors               Vendor[]
  products              Product[]
  orders                Order[]
  invoices              Invoice[]
  bills                 Bill[]
  quotations            Quotation[]
  creditNotes           CreditNote[]
  branches              Branch[]
  warehouses            Warehouse[]
  companySettings       CompanySettings?
  gstSettings           GstSetting?
  subscriptions         SubscriptionHistory[]
  invoicesIssued        SubscriptionInvoice[]
  gstFilingReturns      GstFilingReturn[]
  eWayBills             EWayBill[]
}

model SubscriptionHistory {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan              String       // STARTER, GROWTH, ENTERPRISE
  billingCycle      String       // MONTHLY, QUARTERLY, ANNUALLY
  amount            Float
  currency          String       @default("INR")
  taxAmount         Float        @default(0) // 18% GST on SaaS
  totalAmount       Float
  status            String       @default("PAID") // PAID, PENDING, FAILED, REFUNDED
  paymentMethod     String?      // UPI, CARD, NETBANKING
  gatewayPaymentId  String?
  startDate         DateTime     @default(now())
  endDate           DateTime
  createdAt         DateTime     @default(now())
}

model SubscriptionInvoice {
  id                String       @id @default(uuid())
  invoiceNumber     String       @unique // SaaS-2024-0001
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  amount            Float
  cgst              Float        @default(0)
  sgst              Float        @default(0)
  igst              Float        @default(0)
  total             Float
  paidAt            DateTime?
  pdfUrl            String?
  createdAt         DateTime     @default(now())
}

model PlatformPricingSetting {
  id                    String   @id @default("default")
  starterMonthlyPrice   Float    @default(999)
  starterQuarterlyPrice Float    @default(2699)
  starterAnnualPrice    Float    @default(9599)
  starterMaxUsers       Int      @default(3)
  starterMaxOrders      Int      @default(500)
  starterWhatsAppCredits Int     @default(500)
  starterFeatures       String[] @default(["Up to 3 Users", "1 Branch", "500 Orders / mo", "Basic CRM & Invoicing", "500 WhatsApp Msgs", "GST Reports"])

  growthMonthlyPrice    Float    @default(2499)
  growthQuarterlyPrice  Float    @default(6749)
  growthAnnualPrice     Float    @default(23999)
  growthMaxUsers        Int      @default(10)
  growthMaxOrders       Int      @default(2000)
  growthWhatsAppCredits Int      @default(2500)
  growthFeatures        String[] @default(["Up to 10 Users", "3 Branches & 2 Warehouses", "2,000 Orders / mo", "Full CRM & Purchase Ledger", "Live GST Portal Filing (1/3B/2B)", "2,500 WhatsApp Msgs & AI"])

  enterpriseMonthlyPrice Float   @default(5999)
  enterpriseQuarterlyPrice Float @default(16199)
  enterpriseAnnualPrice   Float  @default(57599)
  enterpriseMaxUsers     Int      @default(999)
  enterpriseMaxOrders    Int      @default(999999)
  enterpriseWhatsAppCredits Int   @default(10000)
  enterpriseFeatures     String[] @default(["Unlimited Users", "Unlimited Branches & Multi-Warehouse", "Unlimited Orders", "Automated E-Way Bill Generation", "Dedicated WhatsApp AI Bot", "Priority Support & API Access"])

  updatedAt             DateTime @updatedAt
}

// ---------------------------------------------------------
// User & Role Management
// ---------------------------------------------------------
model User {
  id                String        @id @default(uuid())
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id])
  name              String
  email             String        @unique
  password          String
  role              String        @default("SALES")
  roleId            String?
  roleDef           Role?         @relation(fields: [roleId], references: [id])
  isActive          Boolean       @default(true)
  canManageSettings Boolean       @default(false)
  allowedSections   String? // Comma-separated or JSON array of section keys allowed for this user
  avatarUrl         String?
  image             String?
  lastActiveAt      DateTime?
  presenceStatus    String?       @default("OFFLINE") // "ONLINE", "IDLE", "OFFLINE"
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  employee          Employee?
  auditLogs         AuditLog[]
  notifications     Notification[]
  customerProfile   Customer?     @relation("CustomerUser")
  broadcastsCreated TeamBroadcast[] @relation("BroadcastAuthor")
  broadcastReplies  BroadcastReply[]
  broadcastReads    BroadcastRead[]
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions String   // JSON string of permissions
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------
// Employee & HR Management
// ---------------------------------------------------------
model Employee {
  id              String   @id @default(uuid())
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  employeeId      String   @unique // Company generated ID
  mobile          String?
  joiningDate     DateTime?
  department      String?
  designation     String?
  employmentStatus String  @default("Active")
  chatAvailable    Boolean @default(true)  // Temporary toggle for chat assignment only
  salary          Float?
  target          Float?
  bankDetails     String?
  address         String?
  emergencyContact String?
  notes           String?

  branchId        String?
  branch          Branch?  @relation(fields: [branchId], references: [id])

  teamId          String?
  team            Team?    @relation(fields: [teamId], references: [id])
  managerId       String?
  manager         Employee? @relation("ManagerToEmployee", fields: [managerId], references: [id])
  subordinates    Employee[] @relation("ManagerToEmployee")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customers       Customer[] @relation("AssignedSalesperson")
  calls           Call[]
  followUps       FollowUp[]
  tasksAssigned   Task[]     @relation("TaskAssignee")
  tasksCreated    Task[]     @relation("TaskCreator")
  orders          Order[]
  attendances     Attendance[]
  leaves          Leave[]
  salaries        Salary[]
  incentives      Incentive[]
  quotations      Quotation[]
  inventoryTransactions InventoryTransaction[]
  expenses        Expense[]
  round1Candidates Candidate[] @relation("CandidateRound1Interviewer")
  round2Candidates Candidate[] @relation("CandidateRound2Interviewer")
  round3Candidates Candidate[] @relation("CandidateRound3Interviewer")
  assignedWhatsAppConversations WhatsAppConversation[] @relation("AssignedAgent")
}

model Team {
  id          String   @id @default(uuid())
  name        String
  description String?
  leaderId    String?  @unique
  members     Employee[]
  whatsAppConversations WhatsAppConversation[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------
// Customer CRM
// ---------------------------------------------------------
model Customer {
  id              String   @id @default(uuid())
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  businessName    String
  contactPerson   String
  mobile          String
  whatsappNumber  String?
  alternatePhone  String?
  gstNumber       String?
  pan             String?
  billingAddress  String?
  shippingAddress String?
  landmark        String?

  openingBalance  Float    @default(0)
  openingBalanceType String? @default("DEBIT") // "DEBIT" (To Receive / Dr) or "CREDIT" (To Pay / Cr)

  regularDiscount String?
  preferredPaymentMethod String?

  customerType    String?  // e.g., Wholesaler, Retailer
  businessCategory String?
  source          String?  // e.g., Website, Reference, Cold Call

  status          String   @default("New Lead")
  leadStage       String   @default("Contacted")

  assignedSalespersonId String?
  assignedSalesperson   Employee? @relation("AssignedSalesperson", fields: [assignedSalespersonId], references: [id])

  lastContactDate DateTime?
  nextFollowUp    DateTime?
  notes           String?
  tags            String?

  healthScore          Float?
  leadScore            Int?
  temperature          String?  // HOT, WARM, COLD
  portalUserId         String?  @unique
  portalUser           User?    @relation("CustomerUser", fields: [portalUserId], references: [id])
  expectedValue        Float? @default(0)
  averageOrderCycleDays Int?
  preferences          String? // JSON string
  territoryId          String?
  territory            Territory? @relation(fields: [territoryId], references: [id])
  marketingOptOut      Boolean  @default(false)
  optedOutAt           DateTime?

  totalPurchaseValue Float @default(0)
  totalOrders        Int   @default(0)
  retentionStatus    String @default("Active")

  branchId        String?
  branch          Branch?  @relation(fields: [branchId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  calls           Call[]
  followUps       FollowUp[]
  tasks           Task[]
  orders          Order[]
  quotations      Quotation[]
  invoices        Invoice[]
  creditNotes     CreditNote[]
  ewayBills       EWayBill[]
  payments        Payment[]

  whatsAppConversations WhatsAppConversation[]
  whatsAppPaymentLinks  WhatsAppPaymentLink[]
  whatsAppFormSubmissions WhatsAppFormSubmission[]
}

// ---------------------------------------------------------
// Sales & Activity (Calls, FollowUps, Tasks)
// ---------------------------------------------------------
model Call {
  id           String   @id @default(uuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  callType     String   // Incoming / Outgoing
  durationSec  Int?
  status       String   // Connected, Missed, etc.
  outcome      String   // Order Confirmed, Call Back, etc.
  notes        String?
  nextAction   String?
  followUpDate DateTime?
  recordingUrl String?
  summary      String?

  createdAt    DateTime @default(now())
}

model FollowUp {
  id           String   @id @default(uuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  date         DateTime
  followUpType String
  priority     String   @default("Medium")
  notes        String?
  expectedOutcome String?
  status       String   @default("Pending") // Pending, Completed, Rescheduled, Cancelled

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Task {
  id           String   @id @default(uuid())
  title        String
  description  String?
  priority     String   @default("Medium")
  dueDate      DateTime?
  status       String   @default("To Do")

  assigneeId   String
  assignee     Employee @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creatorId    String
  creator      Employee @relation("TaskCreator", fields: [creatorId], references: [id])
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------
// Products & Orders
// ---------------------------------------------------------
model Product {
  id              String   @id @default(uuid())
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  name            String
  sku             String?  @unique
  articleNumber   String?  @unique
  hsnCode         String?
  category        String
  subCategory     String?
  fabric          String?
  color           String?
  size            String?
  purchasePrice   Float
  sellingPrice    Float
  mrp             Float
  stockQuantity   Int      @default(0)
  minimumStock    Int      @default(10)
  status          String   @default("Active")
  description     String?
  weight          Float?   @default(0)
  images          String[] @default([])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orderItems      OrderItem[]
  quotationItems  QuotationItem[]
  inventoryTransactions InventoryTransaction[]
  purchaseOrderItems PurchaseOrderItem[]
  creditNoteItems CreditNoteItem[]
  billItems       BillItem[]
  vendorCreditItems VendorCreditItem[]
}

model ProductCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  weight      Float    @default(0)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InventoryTransaction {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  type        String   // "IN", "OUT", "ADJUSTMENT"
  quantity    Int
  reference   String?  // Order ID, PO number, or manual scan
  date        DateTime @default(now())
  employeeId  String?
  employee    Employee? @relation(fields: [employeeId], references: [id])
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  notes       String?
}

model Order {
  id              String   @id @default(uuid())
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  orderNumber     String   @unique
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  salespersonId   String
  salesperson     Employee @relation(fields: [salespersonId], references: [id])

  orderDate       DateTime @default(now())
  deliveryDate    DateTime?

  totalValue      Float
  discount        Float    @default(0)
  tax             Float    @default(0)
  paymentReceived Float    @default(0)
  outstandingAmount Float  @default(0)

  paymentStatus   String   @default("Unpaid") // Unpaid, Partially Paid, Paid
  orderStatus     String   @default("Processing") // Processing, Packed, Dispatched, Delivered, Cancelled
  notes           String?

  // GST & Financial Fields
  placeOfSupply   String?
  subtotal        Float    @default(0)
  cgst            Float    @default(0)
  sgst            Float    @default(0)
  igst            Float    @default(0)
  isInterstate    Boolean  @default(false)

  // Shipping & Tracking fields
  awbNumber       String?
  courierName     String?
  trackingUrl     String?
  dispatchDate    DateTime?
  expectedDeliveryDate DateTime?
  shippingStatus  String? // e.g. "In Transit", "Out for Delivery", "Delivered", "RTO"

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           OrderItem[]
  invoices        Invoice[]
  creditNotes     CreditNote[]
  ewayBills       EWayBill[]
  payments        Payment[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity  Int
  rate      Float
  hsnCode   String? @default("6109")
  gstRate   Float   @default(12)
  cgst      Float   @default(0)
  sgst      Float   @default(0)
  igst      Float   @default(0)
  total     Float
}

// ---------------------------------------------------------
// Performance & Financials
// ---------------------------------------------------------
model Attendance {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  status      String   @default("Present") // Present, Absent, Half Day, Leave
  workingHours Float?
  notes       String?

  createdAt   DateTime @default(now())
}

model Leave {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  leaveType   String
  startDate   DateTime
  endDate     DateTime
  numberOfDays Int
  reason      String
  status      String   @default("Pending") // Pending, Approved, Rejected

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Salary {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  month       String   // e.g. "2023-10"
  basicSalary Float
  hra         Float    @default(0)
  allowances  Float    @default(0)
  deductions  Float    @default(0)
  bonus       Float    @default(0)
  advance     Float    @default(0)
  netSalary   Float
  paymentDate DateTime?
  status      String   @default("Pending") // Pending, Processed, Paid

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Incentive {
  id              String   @id @default(uuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])
  month           String   // e.g. "2023-10"
  eligibleSales   Float
  incentiveRate   Float
  incentiveEarned Float
  status          String   @default("Pending") // Pending, Approved, Paid

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ---------------------------------------------------------
// System & Admin
// ---------------------------------------------------------
model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  action      String
  module      String
  recordId    String
  previousValue String? // JSON string
  newValue      String? // JSON string
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------
// Telecalling (Scripts & Objections)
// ---------------------------------------------------------
model CallScript {
  id          String   @id @default(uuid())
  stage       String   @unique // e.g. "New Lead", "Follow Up", "Negotiation"
  content     String   // The actual script content (can be markdown)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Objection {
  id          String   @id @default(uuid())
  concern     String   // e.g. "Price is too high"
  response    String   // The suggested response
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------
// CRM Additions
// ---------------------------------------------------------
model Territory {
  id          String   @id @default(uuid())
  name        String   @unique
  pincodes    String?  // comma-separated list
  description String?
  customers   Customer[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   // e.g. Alert, Reminder, Message
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model IncentiveRule {
  id          String   @id @default(uuid())
  name        String
  condition   String   // JSON string describing the condition
  rewardType  String   // e.g. Percentage, Fixed
  rewardValue Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------
// Company Settings & Invoicing / Quotations
// ---------------------------------------------------------
model CompanySettings {
  id            String   @id @default("default")
  organizationId String?  @unique
  organization   Organization? @relation(fields: [organizationId], references: [id])
  companyName   String   @default("Espon Clothing Private Limited")
  address       String   @default("Sco 71A , 2nd Floor , Ashoka PlazaDelhi Road")
  city          String   @default("Rohtak")
  state         String   @default("Haryana")
  pincode       String   @default("124001")
  country       String   @default("India")
  gstin         String?  @default("06AAHCE7721Q1Z4")
  pan           String?  @default("AAHCE7721Q")
  mobile        String?  @default("7206066678")
  email         String?  @default("clothingespon@gmail.com")
  website       String?  @default("www.espon.in")
  logoUrl       String?

  bankAccountName String? @default("ESPON CLOTHING PRIVATE LIMITED.")
  accountNumber   String? @default("016805006415")
  ifscCode        String? @default("ICIC0000168")
  branch          String? @default("Rohtak")
  upiId           String? @default("7206066678@OKBIZAXIS")

  signatoryUrl    String?
  signatoryName   String? @default("Ashish Aggarwal")
  signatoryDesignation String? @default("Authorized Signatory")

  themeColor      String? @default("#4f46e5")
  fontFamily      String? @default("Inter")
  fontSize        String? @default("16px")
  buttonRadius    String? @default("8px")
  useBoldText     Boolean @default(false)
  monthlyTarget   Float   @default(2000000)

  callOutcomes    String[] @default(["Interested / Follow-up Needed", "Not Interested", "No Answer / Voicemail", "Order Placed", "Complaint / Support", "Call Back Later"])
  callTypes       String[] @default(["Outbound Call (Made by us)", "Inbound Call (Received from customer)", "In-person Meeting", "WhatsApp Chat"])

  nextQuotationNumber String? @default("QT-1001")
  nextInvoiceNumber   String? @default("INV-1001")

  shopifyStoreDomain  String?
  shopifyAccessToken  String?

  updatedAt       DateTime @updatedAt
}

model Quotation {
  id              String   @id @default(uuid())
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  quotationNumber String   @unique
  revisionNumber  Int      @default(0)
  parentQuoteId   String?
  referenceNumber String?
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  salespersonId   String
  salesperson     Employee @relation(fields: [salespersonId], references: [id])

  date            DateTime @default(now())
  expiryDate      DateTime?
  placeOfSupply   String?
  subject         String?
  shippingAddress String?
  billingAddress  String?

  currency        String   @default("INR")
  paymentTerms    String?
  priceList       String?
  warehouse       String?
  deliveryTerms   String?
  shippingMethod  String?
  expectedDeliveryDate DateTime?
  template        String   @default("Standard")

  subtotal        Float    @default(0)
  itemDiscount    Float    @default(0)
  additionalDiscount Float @default(0)
  taxableAmount   Float    @default(0)
  shippingCharges Float    @default(0)
  adjustment      Float    @default(0)
  roundOff        Float    @default(0)
  receivedAmount  Float    @default(0)
  taxTotal        Float    @default(0)
  cgst            Float    @default(0)
  sgst            Float    @default(0)
  igst            Float    @default(0)
  totalValue      Float
  totalQuantity   Float    @default(0)
  totalItems      Int      @default(0)
  totalWeight     Float?   @default(0)

  isInterstate    Boolean  @default(false)
  status          String   @default("Draft") // Draft, Sent, Viewed, Accepted, Declined, Expired, Converted
  approvalStatus  String   @default("Approved") // Pending Approval, Approved, Rejected

  notes           String?
  internalNotes   String?
  termsConditions String?

  viewedDate      DateTime?
  acceptedDate    DateTime?
  declinedDate    DateTime?
  ipAddress       String?
  digitalSignature String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           QuotationItem[]
  activities      QuotationActivity[]
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])

  sku         String?
  description String?
  hsnCode     String?   @default("6103")
  quantity    Float     @default(1)
  unit        String?   @default("pcs")
  unitWeight  Float?    @default(0)
  rate        Float
  discountPercent Float @default(0)
  discountAmount  Float @default(0)
  taxableAmount   Float @default(0)
  gstRate     Float     @default(0)
  taxAmount   Float     @default(0)
  cgst        Float     @default(0)
  sgst        Float     @default(0)
  igst        Float     @default(0)
  total       Float

