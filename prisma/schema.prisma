  carouselCardsJson String? // JSON string representing multi-card carousel cards
  offerExpiration DateTime? // Limited-Time Offer expiration date
  couponCode      String?   // Promo / Coupon code for copy button
  optOutCount     Int      @default(0) // Count of recipients who clicked Opt-Out or replied STOP
  metaQualityStatus String? // GREEN, YELLOW, RED
  // A/B Testing
  isAbTest        Boolean  @default(false)
  variantTemplateId String?
  abSplitRatio    Int      @default(50) // e.g. 50 for 50/50 split
  // Drip Sequence Automation
  isDripCampaign  Boolean  @default(false)
  dripStepsJson   String?  // JSON string array of follow-up steps
  parentCampaignId String?
  dripStepNumber  Int      @default(1)

  queues          WhatsAppCampaignQueue[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model WhatsAppCampaignQueue {
  id           String           @id @default(uuid())
  campaignId   String
  campaign     WhatsAppCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  toPhone      String
  customerName String?
  customerCity String?
  status       String           @default("PENDING") // PENDING, SENT, DELIVERED, READ, CLICKED, REPLIED, FAILED
  variant      String?          @default("A")       // "A" or "B" for A/B Testing
  dripStep     Int?             @default(1)         // Drip sequence step number
  deliveredAt  DateTime?
  readAt       DateTime?
  clickedAt    DateTime?
  buttonClicked String?
  repliedAt    DateTime?
  replyText    String?
  orderValue   Float?
  metaErrorCode Int?            // Meta API error code (e.g. 131026, 130429, 131047)
  retryCount   Int              @default(0)
  errorMsg     String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model WhatsAppSegment {
  id           String   @id @default(uuid())
  name         String   // High Value, Inactive 90 Days, New Leads, Repeat Buyers, Wholesale
  criteriaJson String
  contactCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WhatsAppPaymentLink {
  id             String   @id @default(uuid())
  conversationId String
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  orderId        String?
  invoiceId      String?
  amount         Float
  currency       String   @default("INR")
  paymentUrl     String
  status         String   @default("PENDING") // PENDING, PAID, FAILED, EXPIRED
  transactionId  String?
  paidAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ---------------------------------------------------------
// Team Broadcasts & Announcements System
// ---------------------------------------------------------
model TeamBroadcast {
  id              String   @id @default(uuid())
  title           String
  content         String
  category        String   @default("GENERAL") // "OFFER", "HOLIDAY", "ANNOUNCEMENT", "URGENT", "GENERAL", "MEETING"
  priority        String   @default("NORMAL")  // "LOW", "NORMAL", "HIGH", "URGENT"

  // Attachments (JSON array of { name: string, url: string, type: string, size?: number })
  attachments     String?  // JSON string

  // Audience Targeting
  targetAudience  String   @default("ALL")     // "ALL" or "SELECTED"
  targetUserIds   String[] @default([])        // Array of User IDs
  targetRoles     String[] @default([])        // Array of Roles e.g. ["SALES", "HR"]

  // Author
  authorId        String
  author          User     @relation("BroadcastAuthor", fields: [authorId], references: [id])

  // Pinned & Status
  isPinned        Boolean  @default(false)
  expiresAt       DateTime?

  // Relations
  replies         BroadcastReply[]
  reads           BroadcastRead[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BroadcastReply {
  id              String   @id @default(uuid())
  broadcastId     String
  broadcast       TeamBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  userId          String
  user            User     @relation(fields: [userId], references: [id])

  content         String
  attachments     String?  // JSON array of attachments if any

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BroadcastRead {
  id              String   @id @default(uuid())
  broadcastId     String
  broadcast       TeamBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  readAt          DateTime @default(now())

  @@unique([broadcastId, userId])
}

