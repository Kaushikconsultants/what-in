// ---------------------------------------------------------
// SaaS Multi-Tenant: WhatsApp Clients (Tenants) & Payments
// ---------------------------------------------------------
model WhatsAppClient {
  id               String   @id @default(uuid())
  businessName     String
  contactEmail     String
  contactPhone     String?
  ownerWhatsApp    String?  // Owner's WA number for blocked clients to reach
  webhookClientId  String   @unique @default(uuid()) // Used in webhook URL
  adminEmail       String?  // Login email of the client's admin user
  adminPassword    String?  // Hashed password set by owner on onboard

  subscriptionPlan   String   @default("STARTER") // TRIAL, STARTER, GROWTH, ENTERPRISE, CUSTOM
  monthlyFee         Float    @default(999)
  subscriptionStatus String   @default("TRIAL")   // TRIAL, ACTIVE, PAST_DUE, BLOCKED
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime @default(now())
  gracePeriodDays    Int      @default(7)

  maxAgents       Int      @default(3)
  isActive        Boolean  @default(true)
  notes           String?

  // Monthly quotas & usage limits
  monthlyMessageQuota Int     @default(5000)
  monthlyAiQuota      Int     @default(500)
  messagesUsedCount   Int     @default(0)
  aiRepliesUsedCount  Int     @default(0)

  // Meta (WhatsApp Business) API credentials — set by owner or client admin
  wabaId             String?  // WhatsApp Business Account ID
  phoneId            String?  // Phone Number ID from Meta
  businessManagerId  String?  // Business Manager ID
  metaAccessToken    String?  // Permanent Access Token
  webhookVerifyToken String?  // Custom webhook verify token
  customWebhookUrl   String?  // Override webhook URL (e.g. legacy clients using default webhook)
  phoneNumber        String?  // Display phone number

  // Shopify credentials — set by owner or client admin
  shopifyDomain      String?
  shopifyToken       String?

  // AI Settings & Credentials per client (100% Client-Isolated)
  geminiApiKey       String?
  aiModel            String?   @default("gemini-3.8-flash")
  aiSystemPrompt     String?
  aiKnowledgeBase    String?
  welcomeMessage     String?   @default("Welcome! How can we help you today?")
  workingHoursStart  String?   @default("09:00")
  workingHoursEnd    String?   @default("19:00")

  // Payment Gateway per client (100% Client-Isolated)
  activeGateway      String?
  razorpayKeyId      String?
  razorpayKeySecret  String?
  cashfreeAppId      String?
  cashfreeSecretKey  String?
  merchantUpiId      String?
  merchantUpiName    String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  payments           WhatsAppClientPayment[]
  agents             WhatsAppAgentUser[]
}

model WhatsAppClientPayment {
  id           String          @id @default(uuid())
  clientId     String
  client       WhatsAppClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  amount       Float
  periodStart  DateTime
  periodEnd    DateTime
  notes        String?
  markedByOwner Boolean        @default(true)
  createdAt    DateTime        @default(now())
}

model WhatsAppAgentUser {
  id                 String          @id @default(uuid())
  clientId           String
  client             WhatsAppClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name               String
  email              String          @unique
  password           String
  role               String          @default("AGENT") // ADMIN, AGENT
  mustChangePassword Boolean         @default(true)
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model WhatsAppAnnouncement {
  id          String    @id @default(uuid())
  title       String
  message     String
  type        String    @default("INFO") // INFO, WARNING, MAINTENANCE, SUCCESS
  isActive    Boolean   @default(true)
  targetPlan  String?   @default("ALL")  // ALL or specific plan
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
